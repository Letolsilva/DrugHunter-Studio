# ─────────────────────────────────────────────────────────────────────────────
# PDB Explorer — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores antes de rodar o projeto.
# ─────────────────────────────────────────────────────────────────────────────

# ── Banco de dados ────────────────────────────────────────────────────────────
# Dev: deixe comentado (SQLite automático em pdb_explorer.db)
# Prod: descomente e aponte para o PostgreSQL
# DATABASE_URL=postgresql://usuario:senha@localhost:5432/pdb_explorer

# ── Segurança JWT ─────────────────────────────────────────────────────────────
# OBRIGATÓRIO em produção: gere com `python -c "import secrets; print(secrets.token_hex(32))"`
SECRET_KEY=TROQUE_ESTA_CHAVE_EM_PRODUCAO_abc123xyz789
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Redocking — DrugHunter ────────────────────────────────────────────────────
# OBRIGATÓRIO para usar a funcionalidade de redocking.
# Sem Docker: aponte para o diretório raiz do DrugHunter na sua máquina.
#   Linux/macOS: DRUG_HUNTER_PATH=/home/SEU_USUARIO/DrugHunter
#   Windows:     DRUG_HUNTER_PATH=C:\Users\SEU_USUARIO\DrugHunter
# Com Docker: use o caminho montado no container (ver docker-compose.yml).
#   DRUG_HUNTER_PATH=/app/drughunter
DRUG_HUNTER_PATH=/home/SEU_USUARIO/DrugHunter

# ── Storage de arquivos PDB ───────────────────────────────────────────────────
# Caminho da pasta onde os .pdb/.cif são salvos (relativo ao backend/ ou absoluto).
# Padrão: pdb_files (pasta dentro de backend/)
# PDB_FILES_DIR=pdb_files

# ── E-mail (notificação ao fim do redocking) ─────────────────────────────────
# Pré-configurado pelo desenvolvedor. Usuários não precisam alterar.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=COLOQUE_SEU_EMAIL@gmail.com
SMTP_PASSWORD=COLOQUE_SUA_SENHA_DE_APP
SMTP_FROM=PDB Explorer <COLOQUE_SEU_EMAIL@gmail.com>
