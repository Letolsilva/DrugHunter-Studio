[Desktop Entry]
Version=1.0
Type=Application
Name=PDB Explorer
Comment=Busca e análise de estruturas proteicas do RCSB PDB
Exec=bash -c 'DIR=$(dirname "$(readlink -f "%k")"); cd "$DIR" && bash iniciar.sh; read -p "Pressione Enter para fechar..." _'
Icon=utilities-terminal
Terminal=true
Categories=Science;Education;
StartupNotify=true
