    end

    subgraph dados["Dados e domínio"]
        direction TB
        uc["<b>data/usecases</b><br/>implementam as interfaces"]
        adp["<b>data/adapters</b><br/>transformam dados p/ gráficos e tabelas"]
        dom["<b>domain/</b><br/>interfaces IXUseCase + modelos"]
    end

    subgraph inf["Infraestrutura"]
        http["<b>infra/http/HTTPClient</b><br/>fetch + Bearer + HttpError"]
